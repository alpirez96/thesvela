# SVELA — environment variables
# Copy to .env.local for local development and set the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# ── Payments (iyzico Checkout Form) ─────────────────────────────
# API and secret key from the iyzico merchant panel (Settings → API keys).
# Sandbox keys come from https://sandbox-merchant.iyzipay.com.
# Without both keys, /api/checkout answers 503 "Payments are not configured yet."
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# API host. Sandbox (the default when unset): https://sandbox-api.iyzipay.com
# Production:                                 https://api.iyzipay.com
# Use sandbox keys with the sandbox host and live keys with the live host.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── Currency (EUR / TRY) ─────────────────────────────────────────
# TRY prices are indexed to the EUR price at the day's EUR/TRY rate
# (TCMB forex selling, then ECB via Frankfurter). Optional last resort, used
# only if both sources fail: TRY per 1 EUR as a decimal number. Leave unset to stop
# offering TRY when no live rate is available.
EUR_TRY_FALLBACK_RATE=

# ── Site ─────────────────────────────────────────────────────────
# Public URL, used for metadata and for iyzico's callback URL
# (<site>/api/iyzico/callback). Leave unset locally to use the request's
# own origin; set it in production, e.g. https://thesvela.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Enquiries (contact form, sent through Resend) ────────────────
# API key from https://resend.com/api-keys. Without it (or without
# ENQUIRY_TO_EMAIL) the form answers 503 and asks visitors to use Instagram.
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate several addresses).
ENQUIRY_TO_EMAIL=
# Sender, on a domain verified in Resend. Defaults to
# "SVELA <onboarding@resend.dev>", which only delivers to your own Resend account address.
ENQUIRY_FROM_EMAIL=
